def get_employee_name():
    return input("Enter employee name (or 'End' to finish): ").strip()

def get_hours_worked():
    while True:
        try:
            return float(input("Enter total hours worked: ").strip())
        except ValueError:
            print("Invalid input. Please enter a numeric value.")

def get_hourly_rate():
    while True:
        try:
            return float(input("Enter hourly rate: ").strip())
        except ValueError:
            print("Invalid input. Please enter a numeric value.")

def get_tax_rate():
    while True:
        try:
            return float(input("Enter income tax rate (as decimal): ").strip())
        except ValueError:
            print("Invalid input. Please enter a decimal value like 0.15 for 15%.")

def calculate_pay(hours, rate, tax_rate):
    gross = hours * rate
    tax = gross * tax_rate
    net = gross - tax
    return gross, tax, net

def display_employee_data(name, hours, rate, gross, tax_rate, tax, net):
    print("\n--- Employee Payroll ---")
    print(f"Employee Name: {name}")
    print(f"Hours Worked: {hours:.2f}")
    print(f"Hourly Rate: ${rate:.2f}")
    print(f"Gross Pay: ${gross:.2f}")
    print(f"Tax Rate: {tax_rate:.2%}")
    print(f"Income Tax: ${tax:.2f}")
    print(f"Net Pay: ${net:.2f}")
    print("------------------------\n")

def display_totals(emp_count, total_hours, total_gross, total_tax, total_net):
    print("\n=== Payroll Summary ===")
    print(f"Total Employees: {emp_count}")
    print(f"Total Hours Worked: {total_hours:.2f}")
    print(f"Total Gross Pay: ${total_gross:.2f}")
    print(f"Total Income Tax: ${total_tax:.2f}")
    print(f"Total Net Pay: ${total_net:.2f}")
    print("=======================\n")

def main():
    emp_count = 0
    total_hours = total_gross = total_tax = total_net = 0.0

    while True:
        name = get_employee_name()
        if name.lower() == "end":
            break

        hours = get_hours_worked()
        rate = get_hourly_rate()
        tax_rate = get_tax_rate()

        gross, tax, net = calculate_pay(hours, rate, tax_rate)
        display_employee_data(name, hours, rate, gross, tax_rate, tax, net)

        emp_count += 1
        total_hours += hours
        total_gross += gross
        total_tax += tax
        total_net += net

    display_totals(emp_count, total_hours, total_gross, total_tax, total_net)

if __name__ == "__main__":
    main()
